    CONFIG.Memory_Type {True_Dual_Port_RAM} \
    CONFIG.Read_Width_A {32} \
    CONFIG.Read_Width_B {32} \
    CONFIG.Register_PortA_Output_of_Memory_Primitives {false} \
    CONFIG.Register_PortB_Output_of_Memory_Primitives {false} \
    CONFIG.Write_Width_A {32} \
    CONFIG.Write_Width_B {32} \
  ] $blk_mem_gen_0


  # Create instance: conv_accel_0, and set properties
  set block_name conv_accel
  set block_cell_name conv_accel_0
  if { [catch {set conv_accel_0 [create_bd_cell -type module -reference $block_name $block_cell_name] } errmsg] } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2095 -severity "ERROR" "Unable to add referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   } elseif { $conv_accel_0 eq "" } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2096 -severity "ERROR" "Unable to referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   }
  
  # Create interface connections
  connect_bd_intf_net -intf_net axi_bram_ctrl_0_BRAM_PORTA [get_bd_intf_pins axi_bram_ctrl_0/BRAM_PORTA] [get_bd_intf_pins blk_mem_gen_0/BRAM_PORTA]
  connect_bd_intf_net -intf_net axi_ic_M00_AXI [get_bd_intf_pins axi_ic/M00_AXI] [get_bd_intf_pins gpio_led/S_AXI]
  connect_bd_intf_net -intf_net axi_ic_M01_AXI [get_bd_intf_pins axi_ic/M01_AXI] [get_bd_intf_pins uart_img/S_AXI]
  connect_bd_intf_net -intf_net axi_ic_M02_AXI [get_bd_intf_pins axi_ic/M02_AXI] [get_bd_intf_pins axi_bram_ctrl_0/S_AXI]
  connect_bd_intf_net -intf_net ps7_M_AXI_GP0 [get_bd_intf_pins ps7/M_AXI_GP0] [get_bd_intf_pins axi_ic/S00_AXI]

  # Create port connections
  connect_bd_net -net blk_mem_gen_0_doutb  [get_bd_pins blk_mem_gen_0/doutb] \
  [get_bd_pins conv_accel_0/bram_rdata]
  connect_bd_net -net conv_accel_0_bram_addr  [get_bd_pins conv_accel_0/bram_addr] \
  [get_bd_pins blk_mem_gen_0/addrb]
  connect_bd_net -net conv_accel_0_bram_en  [get_bd_pins conv_accel_0/bram_en] \
  [get_bd_pins blk_mem_gen_0/enb]
  connect_bd_net -net conv_accel_0_bram_wdata  [get_bd_pins conv_accel_0/bram_wdata] \
  [get_bd_pins blk_mem_gen_0/dinb]
  connect_bd_net -net conv_accel_0_bram_we  [get_bd_pins conv_accel_0/bram_we] \
  [get_bd_pins blk_mem_gen_0/web]
  connect_bd_net -net gpio_led_gpio_io_o  [get_bd_pins gpio_led/gpio_io_o] \
  [get_bd_ports led]
  connect_bd_net -net ps7_FCLK_CLK0  [get_bd_pins ps7/FCLK_CLK0] \
  [get_bd_pins rst_100m/slowest_sync_clk] \
  [get_bd_pins axi_ic/ACLK] \
  [get_bd_pins axi_ic/S00_ACLK] \
  [get_bd_pins axi_ic/M00_ACLK] \
  [get_bd_pins axi_ic/M01_ACLK] \
  [get_bd_pins axi_ic/M02_ACLK] \
  [get_bd_pins ps7/M_AXI_GP0_ACLK] \
  [get_bd_pins uart_img/s_axi_aclk] \
  [get_bd_pins gpio_led/s_axi_aclk] \
  [get_bd_pins axi_bram_ctrl_0/s_axi_aclk] \
  [get_bd_pins conv_accel_0/clk] \
  [get_bd_pins blk_mem_gen_0/clkb]
  connect_bd_net -net ps7_FCLK_RESET0_N  [get_bd_pins ps7/FCLK_RESET0_N] \
  [get_bd_pins rst_100m/ext_reset_in]
  connect_bd_net -net rst_100m_peripheral_aresetn  [get_bd_pins rst_100m/peripheral_aresetn] \
  [get_bd_pins axi_ic/ARESETN] \
  [get_bd_pins axi_ic/S00_ARESETN] \
  [get_bd_pins axi_ic/M00_ARESETN] \
  [get_bd_pins axi_ic/M01_ARESETN] \
  [get_bd_pins axi_ic/M02_ARESETN] \
  [get_bd_pins uart_img/s_axi_aresetn] \
  [get_bd_pins gpio_led/s_axi_aresetn] \
  [get_bd_pins axi_bram_ctrl_0/s_axi_aresetn] \
  [get_bd_pins conv_accel_0/rstn]
  connect_bd_net -net uart_img_rxd_1  [get_bd_ports uart_img_rxd] \
  [get_bd_pins uart_img/rx]
  connect_bd_net -net uart_img_tx  [get_bd_pins uart_img/tx] \
  [get_bd_ports uart_img_txd]

  # Create address segments
  assign_bd_address -offset 0x40000000 -range 0x00080000 -target_address_space [get_bd_addr_spaces ps7/Data] [get_bd_addr_segs axi_bram_ctrl_0/S_AXI/Mem0] -force
  assign_bd_address -offset 0x41200000 -range 0x00010000 -target_address_space [get_bd_addr_spaces ps7/Data] [get_bd_addr_segs gpio_led/S_AXI/Reg] -force
  assign_bd_address -offset 0x42C00000 -range 0x00010000 -target_address_space [get_bd_addr_spaces ps7/Data] [get_bd_addr_segs uart_img/S_AXI/Reg] -force


  # Restore current instance
  current_bd_instance $oldCurInst

  validate_bd_design
  save_bd_design
}
# End of create_root_design()


